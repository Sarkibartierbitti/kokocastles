# Cloudflare Worker URL for YouTube transcript scraping
# (CORS blocks direct fetch of youtube.com/watch from the browser)
#
# Deploy the worker first:
#   cd proxy && npx wrangler deploy
#
# Copy the workers.dev URL printed by wrangler, then set it here:
VITE_PROXY_URL=

# After editing this file, save it as .env.local (gitignored) and restart `npm run dev`.
